{
  "name": "arn-bulletin-generator-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCKS=true vite",
    "dev:airplan": "VITE_USE_MOCKS=true VITE_AIR_PLAN_DEMO=true vite",
    "fixtures:here": "node scripts/fetch-here-traffic.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint . && npm run lint:tw",
    "lint:tw": "oxlint src",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "TZ=Australia/Sydney vitest run",
    "test:watch": "TZ=Australia/Sydney vitest",
    "knip": "knip",
    "audit": "node scripts/ux-audit.mjs",
    "review": "node scripts/ux-review.mjs",
    "ui:inventory": "node scripts/ui-inventory.mjs",
    "ui:inventory:check": "node scripts/ui-inventory.mjs --check",
    "build:mock": "VITE_USE_MOCKS=true VITE_USE_DEV_AUTH=true vite build --outDir dist-mock",
    "perf": "npm run build:mock && node scripts/perf-audit.mjs",
    "perf:nobuild": "node scripts/perf-audit.mjs",
    "perf:runtime": "npm run build:mock && node scripts/perf-runtime.mjs",
    "perf:runtime:nobuild": "node scripts/perf-runtime.mjs",
    "e2e": "node ./node_modules/@playwright/test/cli.js test",
    "e2e:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
    "e2e:headed": "node ./node_modules/@playwright/test/cli.js test --headed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cronstrue": "^3.20.0",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.17.1",
    "lighthouse": "^13.4.0",
    "oxlint": "^1.75.0",
    "oxlint-tailwindcss": "^1.6.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@opentelemetry/core": "^2.10.0"
  }
}
