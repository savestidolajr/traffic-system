{
  "Providers": {
    "OutputProvider": "Console"
  },
  "Broadcast": {
    "MaxGenerationRetries": 2,
    "MaxSynthesisAttempts": 2,
    "ScheduleLeadTimeMinutes": 15,
    "FallbackDeadlineMinutes": 3
  },
  "SpeechDuration": {},
  "Here": {
    "ApiKey": "",
    "TrafficBaseUrl": "https://data.traffic.hereapi.com/v7",
    "GeocodingBaseUrl": "https://geocode.search.hereapi.com/v1",
    "RoutingBaseUrl": "https://router.hereapi.com/v8",
    "IncidentsPath": "incidents",
    "GeocodePath": "geocode",
    "ReverseGeocodePath": "revgeocode",
    "AllowedIncidentTypes": [
      "accident",
      "congestion",
      "construction",
      "disabledVehicle",
      "laneRestriction",
      "roadClosure",
      "roadHazard",
      "plannedEvent"
    ]
  },
  "AiSettings": {
    "AzureAI": {
      "Endpoint": "",
      "Model": ""
    },

    "ElevenLabs": {
      "ApiKey": "",
      "VoiceId": "",
      "ModelId": "eleven_v3",
      "BaseUrl": "https://api.elevenlabs.io/v1/text-to-speech",
      "OutputFormat": "pcm_24000",
      "TimeoutSeconds": 120,
      "UseTimestampsEndpoint": true,
      "LanguageCode": "en",
      "VoiceSettings": {
        "Stability": 1.0,
        "SimilarityBoost": 0.80,
        "Style": 0.20,
        "UseSpeakerBoost": true,
        "Speed": 1.0,
        "Seed": 42
      },
      "Synthesizer": {
        "MinSpeed": 0.95,
        "MaxSpeed": 1.05,
        "SpeedAdjustmentThreshold": 0.01
      }
    }
  },
  "Prompts": {
    "SystemPrompt": "You are a traffic bulletin presenter for Australian radio.",
    "ReviewPrompt": "Review the script for accuracy and brevity.",
    "RefinePrompt": "Refine the script to fit the target duration."
  },
  "Storage": {
    "AccountName": "devstoreaccount1",
    "ContainerName": "broadcasts"
  },
  "AzureSearch": {
    "Enabled": false
  }
}
