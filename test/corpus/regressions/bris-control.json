        {
          "Id": "805e0cdd0ce947588bbb591a659b4b60",
          "Scope": 1,
          "ScopeId": "brisbane",
          "Type": 2,
          "Text": "Brisbane names: \u0027the Gateway\u0027, \u0027the Bruce Highway\u0027, \u0027the M1\u0027, \u0027the Pacific Motorway\u0027, \u0027the Riverside Expressway\u0027, \u0027the Story Bridge\u0027, \u0027the ICB\u0027.",
          "Enabled": true,
          "CreatedBy": "seed:arn-data",
          "CreatedAtUtc": "2026-06-19T04:11:48.86574Z",
          "UpdatedAtUtc": "2026-06-19T04:11:48.86574Z",
          "Source": "manual",
          "ReviewAfterUtc": null
        },
        {
          "Id": "677eb8ef3d2b4ccfbde396291a30ca2a",
          "Scope": 0,
          "ScopeId": "",
          "Type": 1,
          "Text": "Lead with the incident causing the longest delay or affecting the most drivers. Cover as many named, real items as the slot word target calls for \u2014 a listener paid with dead air for a fact you were given and did not voice. Do not stop at three or four when more grounded roads are available; the slot capacity and word target already set the ceiling. Close with a short safety sign-off.",
          "Enabled": true,
          "CreatedBy": "operator@arn.com.au",
          "CreatedAtUtc": "2026-07-08T02:17:04.3391028Z",
          "UpdatedAtUtc": "2026-07-08T02:17:04.3391028Z",
          "Source": "manual",
          "ReviewAfterUtc": null
        },
        {
          "Id": "645e52b90299493a8dbde1205c6c657e",
          "Scope": 0,
          "ScopeId": "",
          "Type": 0,
          "Text": "no breath\u0027s in voice",
          "Enabled": true,
