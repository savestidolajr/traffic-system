          "ReviewAfterUtc": null
        },
        {
          "Id": "75fe175d471144b38bf23c24966dfb6f",
          "Scope": 0,
          "ScopeId": "",
          "Type": 1,
          "Text": "no breath\u0027s in voice",
          "Enabled": true,
