{
 "schemaVersion": 1,
 "model": "token-additive prosody cost + per-voice intercept",
 "formula": "predictedSecondsAtSpeed1 = perSyllableSec*syllables + wordBoundarySec*plainWords + commaSec*commas + periodSec*periods + ellipsisSec*ellipses + dashSec*dashes + interceptSec; plainWords = words - commas - periods - ellipses - dashes (floored at 0); realSeconds = predictedSecondsAtSpeed1 / voiceSpeed",
 "fittedFrom": "test/corpus/duration schemaVersion 3; clean rows only; fingerprints with >=8 clean bulletins",
 "partialPooling": {
  "minObservationsPerClass": 25,
  "pooledGlobal": {
   "none": 0.10159,
   "comma": 0.33042,
   "period": 0.4617,
   "ellipsis": 0.49089,
   "dash": 0.01206
  },
  "globalPerSyllableSec": 0.15565,
  "rationale": "Ridge shrinks an UNOBSERVED punctuation class to zero, which would price an ellipsis at 0s. No voice has more than 5 ellipsis tokens, so ellipsis and dash always fall back to the pooled global cost. This matters live: every Cairns bulletin opens with one."
 },
