   "freeScaleAffine": {
    "crossSlotMaeSec": 5.31,
    "note": "LOOCV said 1.12s - an artefact. ARN Sarah's corpus is 100% 22s targets, so a free scale term degenerated to 'always predict 22s' (scale 0.056, intercept 21.97) and scored well only because held-out rows were also 22s."
   },
   "syllablesPlusIntercept": {
    "crossSlotMaeSec": 5.07,
    "note": "same failure mode; LOOCV said 1.13s"
   }
  },
  "lesson": "LOOCV over a corpus dominated by one slot length cannot detect a model that has learned the slot length instead of the content. Cross-slot holdout is the only honest gate here."
 },
