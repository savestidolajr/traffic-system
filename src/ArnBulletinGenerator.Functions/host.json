{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request;Dependency"
      }
    },
    "logLevel": {
      "default": "Information",
      "Host.Results": "Information",
      "Function": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Azure.Core": "Error"
    }
  },
  "functionTimeout": "00:10:00",
  "extensions": {
    "http": {
      "routePrefix": "api"
    },
    "queues": {
      "messageEncoding": "none",
      "maxPollingInterval": "00:00:02",
      "maxDequeueCount": 3,
      "visibilityTimeout": "00:00:45",
      "batchSize": 32,
      "newBatchThreshold": 16
    }
  }
}
