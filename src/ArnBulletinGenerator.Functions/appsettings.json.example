{
  "AzureWebJobsStorage": "UseDevelopmentStorage=true",
  "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
  "AadClientId": "",
  "Auth": {
    "DevFallbackRole": ""
  },
  "Providers": {
    "OutputProvider": "AzureBlob",
    "ExternalProviderMode": "Real"
  },
  "KeyVaultUri": "",
  "AiSettings": {
    "ElevenLabs": {
      "ApiKey": "",
      "PronunciationDictionaryId": "",
      "PronunciationDictionaryVersionId": "",
      "PronunciationDictionaries": {
        "sydney": {
          "DictionaryId": "",
          "VersionId": ""
        }
      },
      "LanguageCode": "en"
    },
    "AzureAI": {
      "Endpoint": "",
      "ApiKey": "",
      "Model": "gpt-5.6-luna"
    }
  },
  "Here": {
    "ApiKey": "",
    "MapApiKey": "",
    "TrafficBaseUrl": "https://data.traffic.hereapi.com/v7",
    "GeocodingBaseUrl": "https://geocode.search.hereapi.com/v1",
    "RoutingBaseUrl": "https://router.hereapi.com/v8"
  },
  "Broadcast": {
    "MaxGenerationRetries": 3,
    "MaxSynthesisAttempts": 3,
    "FillerCartAudioUrl": "",
    "FillerCartScript": ""
  },
  "ContentSafety": {
    "BannedWords": [],
    "Substitutions": {
      "accident": "incident"
    }
  },
  "Weather": {
    "Enabled": false
  },
  "Fuel": {
    "Enabled": false
  },
  "Storage": {
    "AccountName": "devstoreaccount1",
    "ContainerName": "broadcasts"
  },
  "Host": {
    "CORS": "http://localhost:5173",
    "CORSCredentials": true
  }
}
