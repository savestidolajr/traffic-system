  "OfficialFeeds": {
    "_comment": "Local-only defaults. A FULL bicep deploy sets OfficialFeeds__* app settings (QldApiKey deliberately blank) which override this file, and the real key arrives as the Key Vault secret OfficialFeeds--QldApiKey. CAVEAT: a CODE-ONLY deploy ships this file WITHOUT those app settings, so until an environment has had the bicep applied this demo key IS the effective key there. That is intentional and behaviour-neutral (it matches pre-RISK-36 behaviour) but it means the demo key can be live in a deployed env, and the startup warning naming RISK-36 will say so.",
    "Enabled": true,
    "CorroborateIncidents": true,
    "InjectMissingOfficialIncidents": true,
    "MaxCorroborationDistanceMeters": 500.0,
    "NswHazardsBaseUrl": "https://www.livetraffic.com/traffic/hazards",
