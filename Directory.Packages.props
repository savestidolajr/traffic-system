<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Domain dependencies -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />

    <!-- Application dependencies -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />

    <!-- Infrastructure dependencies -->
    <PackageVersion Include="Azure.Data.Tables" Version="12.11.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Search.Documents" Version="12.0.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageVersion Include="Azure.Storage.Files.Shares" Version="12.27.1" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.27.1" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <PackageVersion Include="Handlebars.Net" Version="2.1.6" />
    <PackageVersion Include="SoundTouch.Net" Version="2.3.2" />

    <!-- Functions dependencies -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
    <!-- Microsoft.ApplicationInsights.WorkerService is pinned to the latest stable 2.x line.
         3.x migrated to an OpenTelemetry-based core that removes ITelemetryInitializer/
         ITelemetryProcessor extensibility; Microsoft.Azure.Functions.Worker.ApplicationInsights
         depends on those and throws TypeLoadException at startup against 3.x, and the Functions
         team has stated they will not ship a compatible release (they recommend OpenTelemetry
         instead). See https://github.com/Azure/azure-functions-dotnet-worker/issues/3322.
         Re-evaluate if/when we migrate Functions telemetry to OpenTelemetry directly. -->
    <PackageVersion Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.51.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.4" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- JWT/OIDC validation for the Static Web Apps rolesSource sign-in path
         (SwaRolesSourceTokenValidator). 8.22.0 is the latest stable of the IdentityModel line
         (verified against the NuGet feed); the two packages are released as a set and MUST stay
         on the same version. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />

    <!-- Test dependencies -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- NSubstitute is pinned below latest (6.0.0). 6.0.0 enables nullable annotations on its
         public API, which turns the Arg.Is<T>/Arg.Any<T> predicate parameter into a nullable
         reference type; with TreatWarningsAsErrors + Nullable enabled repo-wide, that alone
         produces 100+ CS8600/CS8602/CS8604 errors across every test project's substitute
         call sites, with no functional or security benefit (5.3.0 has no known vulnerabilities).
         Re-evaluate once the surface is null-annotated deliberately, not as a version-bump side effect. -->
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- Infrastructure.Tests additional dependencies -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageVersion Include="WireMock.Net" Version="2.13.0" />
    <!-- Scriban.Signed 7.2.5 is the latest release and is also the floor WireMock.Net.Minimal
         2.13.0 itself declares, so this pin is now redundant with upstream but kept explicit
         as a deliberate security floor (originally added to clear GHSA-24c8-4792-22hx,
         GHSA-q6rr-fm2g-g5x8, GHSA-6q7j-xr26-3h2c). -->
    <PackageVersion Include="Scriban.Signed" Version="7.2.5" />

    <!-- ExternalSmoke.Tests additional dependencies -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />

    <!-- Architecture tests -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- E2E.Tests additional dependencies (already covered by Infrastructure versions above) -->
  </ItemGroup>
</Project>
