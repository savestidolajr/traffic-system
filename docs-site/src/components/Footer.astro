---
// Ft2 · inline single line. Starlight's footer, then one hairline and one
// line of type: what this is, when it was current, who prepared it. The
// supplier's mark sits here rather than in the header because this is ARN's
// operational documentation for a platform ARN owns.
import Default from '@astrojs/starlight/components/Footer.astro'
---

<Default><slot /></Default>

<div class="arn-colophon">
    <span>ARN Information Bulletin Platform</span>
    <span class="arn-colophon__sep" aria-hidden="true">·</span>
    <span>Current as at September 2026</span>
    <span class="arn-colophon__sep" aria-hidden="true">·</span>
    <span class="arn-colophon__credit">Prepared by Arinco · September 2026</span>
</div>

<style>
    .arn-colophon {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0 var(--space-2xs);
        margin-block-start: var(--space-xl);
        padding-block-start: var(--space-md);
        border-top: var(--rule-hair) solid var(--color-line);
        font-family: var(--font-outlier);
        font-size: var(--text-2xs);
        letter-spacing: 0.02em;
        color: var(--color-ink-3);
    }

    .arn-colophon__sep {
        color: var(--color-line-2);
    }

    .arn-colophon__credit {
        margin-inline-start: auto;
    }

    @media (max-width: 30rem) {
        .arn-colophon__credit {
            margin-inline-start: 0;
        }
    }
</style>
