{
  "name": "arn-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ARN-facing documentation site for the Information Bulletin Platform. Content is generated from docs/ by scripts/build-docs-site.py; do not edit src/content/docs by hand.",
  "scripts": {
    "sync": "python3 ../scripts/build-docs-site.py",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.1.4",
    "sharp": "^0.35.3"
  }
}
