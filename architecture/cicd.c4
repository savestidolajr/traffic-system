// ══════════════════════════════════════════════════════════════
// CI/CD — Azure DevOps multi-stage delivery pipeline
// ══════════════════════════════════════════════════════════════

model {

  devops = external "Azure DevOps" {
    summary "CI/CD build, test, eval-gate, and deploy to all environments"
    technology "YAML multi-stage pipeline (azure-pipelines.yml)"
    style { color slate }

    repo = stage "Azure Repos" {
      summary "master (single trunk, no develop/main split); pushes and PRs both trigger Build + Package"
    }
    buildTest = stage "Build & Test" {
      summary "Backend build + full test suite + backend E2E, Bicep lint, gitleaks secret scan, .NET dependency vulnerability scan; publishes the Functions artifact"
    }
    package = stage "Package (frontend)" {
      summary "Lint, vitest, npm audit, Playwright E2E (mock mode), Lighthouse perf budget, build; publishes the web artifact. Runs in parallel with Build & Test (dependsOn: [])"
    }
    evalGateGolden = stage "Eval gate (golden)" {
      summary "Blocking Foundry evals over the frozen golden + safety sets, graded in the dev Foundry project; parameter-gated (enableEvalGate), path-gated on PRs, always runs on pushes"
    }
    deployDev = stage "Deploy Dev" {
      summary "Infra (Bicep + autoscale) -> Functions zip-deploy + Static Web App deploy (parallel) -> smoke test (/api/health + auth fail-closed); parameter-gated (enableDeploy); dev ADO environment carries an approval check"
    }
    deployTest = stage "Deploy Test" {
      summary "Same Infra -> Functions + SWA -> smoke pattern as Dev, plus the RBAC SWA config overlay; parameter-gated (enableDeploy AND enablePromotion); test ADO environment approval — approver nomination pending ARN"
    }
    evalGateTest = stage "Eval gate (promotion)" {
      summary "Real-bulletin panel generated in Test via the scheduled poller, graded against the promotion gate; parameter-gated (enableEvalGate)"
    }
    deployProd = stage "Deploy Prod" {
      summary "Same Infra -> Functions + SWA -> smoke pattern; production ADO environment approval — approver nomination pending ARN"
    }
    notifyOnFailure = stage "Notify on failure" {
      summary "Posts a Teams Adaptive Card via the notification Logic App when Build, Package, or the scheduled Eval drift watch fails; no-ops if the webhook secret is unset"
    }
    evalDrift = stage "Eval drift (scheduled)" {
      summary "Nightly harvest of yesterday's production bulletins + deterministic drift gate; weekly full-judge run and judge canary on Sundays; runs only on the cron schedule, never on pushes"
    }
  }

  // ── Pipeline flow ──
  devops.repo -> devops.buildTest "push / PR (master)"
  devops.repo -> devops.package "push / PR (master)"
  devops.buildTest -> devops.evalGateGolden "on success"
  devops.package -> devops.evalGateGolden "on success"
  devops.evalGateGolden -> devops.deployDev "on success"
  devops.deployDev -> devops.deployTest "on success"
  devops.deployTest -> devops.evalGateTest "on success"
  devops.evalGateTest -> devops.deployProd "on success"

  // ── Failure notification ──
  devops.buildTest -> devops.notifyOnFailure "on failure"
  devops.package -> devops.notifyOnFailure "on failure"
  devops.evalDrift -> devops.notifyOnFailure "on failure"

  // ── Scheduled trigger (independent of push) ──
  devops.repo -> devops.evalDrift "cron schedule (nightly / weekly)"

  // ── Deploy targets (every deploy stage deploys both) ──
  devops.deployDev -> arn.functions "deploy" { technology "Bicep + zip" }
  devops.deployDev -> arn.dashboard "deploy" { technology "SWA CLI" }
  devops.deployTest -> arn.functions "deploy" { technology "Bicep + zip" }
  devops.deployTest -> arn.dashboard "deploy" { technology "SWA CLI" }
  devops.deployProd -> arn.functions "deploy" { technology "Bicep + zip" }
  devops.deployProd -> arn.dashboard "deploy" { technology "SWA CLI" }
}
